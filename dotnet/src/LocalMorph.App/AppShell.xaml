<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LocalMorph.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LocalMorph.App"
    Title="LocalMorph"
    Shell.NavBarIsVisible="False"
    Background="{OnPlatform WinUI=Transparent, Default={AppThemeBinding Light=#F3F5F9, Dark=#0D1117}}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
