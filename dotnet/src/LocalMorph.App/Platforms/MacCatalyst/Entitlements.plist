<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!-- Direct-download distribution: the sandbox stays off so the app can spawn FFmpeg and the
             other tools installed on the user's Mac. Hardened runtime is enabled at publish time. -->
        <key>com.apple.security.app-sandbox</key>
        <false/>
        <key>com.apple.security.network.client</key>
        <true/>
        <!-- .NET's JIT needs these under the hardened runtime. -->
        <key>com.apple.security.cs.allow-jit</key>
        <true/>
        <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
        <true/>
        <key>com.apple.security.cs.disable-library-validation</key>
        <true/>
    </dict>
</plist>

