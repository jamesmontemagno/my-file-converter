<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <PackageId>LocalMorph.Bridge</PackageId>
    <Authors>James Montemagno</Authors>
    <Description>Local, authenticated FFmpeg companion service for LocalMorph.</Description>
    <PackageTags>localmorph;ffmpeg;converter;bridge;tool</PackageTags>
    <PackageProjectUrl>https://github.com/jamesmontemagno/my-file-converter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jamesmontemagno/my-file-converter</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>localmorph-bridge</ToolCommandName>
    <PackAsToolShimRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</PackAsToolShimRuntimeIdentifiers>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is bundled into the tool package rather than published as its own NuGet dependency. -->
    <ProjectReference Include="..\LocalMorph.Core\LocalMorph.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Copy referenced project assemblies into the tool's lib folder so `dotnet tool install` has everything it needs. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeReferencedProjectsInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="BridgeOptions.cs" />
    <Compile Remove="Contracts.cs" />
    <Compile Remove="Ffmpeg.cs" />
  </ItemGroup>
</Project>
